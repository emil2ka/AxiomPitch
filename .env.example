# Локальный мост PitchFlow (npm run server). Скопируй в .env.local.
# Оставь пустым, чтобы работать без сервера: колода, камера и история
# по-прежнему работают только в браузере.
VITE_API_BASE_URL=http://127.0.0.1:8787

# Аккаунты Supabase (почта и пароль). Оба значения: Project Settings -> API.
# Пусто — профили живут только на этом устройстве, как раньше.
# Publishable key (sb_publishable_…) или старый anon key. Никогда не service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
